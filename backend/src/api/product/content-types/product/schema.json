{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "text"
    },
    "SKU": {
      "type": "string",
      "unique": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Name"
    },
    "Series": {
      "type": "enumeration",
      "enum": [
        "Серия 11",
        "Серия 12",
        "Серия 13",
        "Серия 24",
        "Серия 25",
        "Серия 26",
        "Серия 27",
        "Серия 28",
        "ALFA",
        "MASTER",
        "Сжимы",
        "Аксессуары"
      ]
    },
    "IP_Rating": {
      "type": "enumeration",
      "enum": [
        "IP20",
        "IP30",
        "IP40",
        "IP44",
        "IP54",
        "IP55",
        "IP65",
        "IP66"
      ]
    },
    "Is_Individual_Pack": {
      "type": "boolean"
    },
    "Images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Drawing": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Passport_PDF": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Type": {
      "type": "string"
    },
    "Mounting_Type": {
      "type": "string"
    },
    "Material": {
      "type": "string"
    },
    "Color": {
      "type": "string"
    },
    "Description": {
      "type": "text"
    }
  }
}
